
---
permalink: index.html
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>auti-index</title>
  <link rel="stylesheet" href="{{ '/style.css' | url }}">
</head>
<body>

<header>
  <h1>auti-index</h1>
  <p>Short writings and observations.</p>
</header>

<main>
  <nav id="index" aria-label="Entry index">
    <h2>INDEX (A–Z)</h2>
    <p>Sort: <strong>A–Z</strong> | <a href="{{ '/date/' | url }}">By date</a></p>

    <ol>
      {% for post in collections.posts | sort(attribute="data.title") %}
      <li><a href="#{{ post.data.slug }}">{{ post.data.title }}</a></li>
      {% endfor %}
    </ol>
  </nav>

  <hr>

  <section aria-label="Entries">
    {% for post in collections.posts | reverse %}
    <article id="{{ post.data.slug }}">
      <h2>{{ post.data.title }}</h2>
      <p class="date">{{ post.date | dateDisplay }}</p>
      {{ post.templateContent | safe }}
      <p><a href="#index">↑ Back to index</a></p>
    </article>
    <hr>
    {% endfor %}
  </section>
</main>

</body>
</html>
